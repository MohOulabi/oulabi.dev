# Text is stored and checked out with LF line endings
* text=auto eol=lf

# Binary files
*.pdf binary
*.ttf binary
*.webp binary
*.png binary
*.jpg binary
*.ico binary

# Third-party data, kept out of GitHub's language stats and diffs
public/benchmarks/** linguist-vendored
data-src/** linguist-vendored

