# Copy to .env.local to override a value. .env.local is never committed: the Vercel CLI keeps its
# token there.

# The site's address, used for the canonical URL, the sitemap, the structured data and llms.txt.
# Optional: src/content/site.ts defaults to https://oulabi.dev.
# NEXT_PUBLIC_SITE_URL=https://oulabi.dev
